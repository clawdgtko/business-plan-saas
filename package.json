{
  "name": "business-plan-saas",
  "version": "0.1.0",
  "description": "Business Plan SaaS - Générateur IA de business plans professionnels",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "vite build",
    
    "# --- Tests ---": "",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:stripe": "vitest run tests/stripe",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:stripe && npm run test:e2e",
    "test": "npm run test:unit",
    
    "# --- Qualité ---": "",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.{ts}\"",
    "typecheck": "tsc --noEmit",
    
    "# --- DB ---": "",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:migrate:create": "wrangler d1 migrations create DB",
    "db:seed": "tsx scripts/seed.ts",
    
    "# --- Stripe ---": "",
    "stripe:listen": "stripe listen --forward-to localhost:8787/api/webhooks/stripe",
    "stripe:trigger": "stripe trigger",
    
    "# --- Release & Versioning ---": "",
    "version:current": "./scripts/version.sh current",
    "version:bump": "./scripts/version.sh",
    "version:patch": "./scripts/version.sh patch --tag",
    "version:minor": "./scripts/version.sh minor --tag",
    "version:major": "./scripts/version.sh major --tag",
    "version:rc": "./scripts/version.sh rc --tag",
    "version:release": "./scripts/version.sh release --tag",
    "health:check": "curl -s https://api.businessplan.pro/health",
    "monitor:active": "echo 'Monitoring actif - vérifiez Sentry et Cloudflare'"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "stripe": "^17.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.21.0",
    "jsdom": "^24.0.0",
    "miniflare": "^3.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "vitest-environment-miniflare": "^2.14.0",
    "vue": "^3.4.0",
    "wrangler": "^3.28.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
