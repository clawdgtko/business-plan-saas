{
  "name": "business-plan-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply business-plan-db",
    "db:migrate:local": "wrangler d1 migrations apply business-plan-db --local",
    "db:create": "wrangler d1 create business-plan-db",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:analytics": "vitest run tests/analytics-events.test.js"
  },
  "dependencies": {
    "hono": "^3.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "vitest": "^1.2.0",
    "wrangler": "^3.22.0"
  }
}